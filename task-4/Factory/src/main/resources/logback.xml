<configuration>

    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>factory_logs.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="FILE" />
    </root>
    <root level="DEBUG">
        <appender-ref ref="FILE" />
    </root>
</configuration>